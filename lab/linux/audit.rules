## home-soc-lab: auditd rules for UBU-SRV01 (Ubuntu Server 22.04 / 24.04)
##
## Install:  sudo cp audit.rules /etc/audit/rules.d/50-soclab.rules
##           sudo augenrules --load
## Check:    sudo auditctl -l
##
## Not tested in this repo. Several watches and the overall layout are adapted
## from Neo23x0/auditd (Apache License 2.0, https://github.com/Neo23x0/auditd),
## cut down to what the lab and the rules in detections/linux need.

## Start clean, give the kernel a bigger backlog, log (not panic) on failure.
-D
-b 8192
-f 1
--backlog_wait_time 60000

## ---------------------------------------------------------------------------
## Changes to auditing itself
## ---------------------------------------------------------------------------
-w /etc/audit/ -p wa -k audit_config
-w /etc/libaudit.conf -p wa -k audit_config
-w /usr/sbin/auditctl -p x -k audit_tools
-w /usr/sbin/auditd -p x -k audit_tools
-w /usr/sbin/augenrules -p x -k audit_tools

## ---------------------------------------------------------------------------
## Accounts, groups, sudo
## ---------------------------------------------------------------------------
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /usr/sbin/useradd -p x -k user_mgmt
-w /usr/sbin/adduser -p x -k user_mgmt
-w /usr/sbin/usermod -p x -k user_mgmt
-w /usr/sbin/userdel -p x -k user_mgmt
-w /usr/sbin/groupadd -p x -k user_mgmt
-w /usr/sbin/chpasswd -p x -k user_mgmt

## Reads of /etc/shadow by logged-in users (PAM helpers run without an auid, so
## normal logins do not trigger this).
-a always,exit -F arch=b64 -S open,openat -F path=/etc/shadow -F auid>=1000 -F auid!=unset -k shadow_read

## ---------------------------------------------------------------------------
## SSH server config and keys
## ---------------------------------------------------------------------------
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config
-w /root/.ssh/ -p wa -k ssh_keys
## auditd watches do not take wildcards: add one line per account.
-w /home/labadmin/.ssh/ -p wa -k ssh_keys

## ---------------------------------------------------------------------------
## Scheduled jobs, services, loader hijacks
## ---------------------------------------------------------------------------
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /var/spool/cron/ -p wa -k cron
-w /etc/systemd/system/ -p wa -k systemd_units
-w /usr/lib/systemd/system/ -p wa -k systemd_units
-w /etc/ld.so.preload -p wa -k ld_preload

## ---------------------------------------------------------------------------
## Kernel modules
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_modules
-w /usr/bin/kmod -p x -k kernel_modules

## ---------------------------------------------------------------------------
## Process execution
## ---------------------------------------------------------------------------
## Every execve, 64 and 32 bit. Each one produces SYSCALL, EXECVE (arguments),
## CWD, PATH and PROCTITLE records. That is fine on a quiet lab server; on a
## busy one, scope it with -F auid>=1000 -F auid!=unset plus explicit rules for
## service accounts such as www-data (uid 33) and tomcat.
## Rules that use this: lnx_auditd_useradd, lnx_auditd_base64_decode.
-a always,exit -F arch=b64 -S execve -k exec
-a always,exit -F arch=b32 -S execve -k exec

## Outbound connections made directly by a shell (reverse shells via /dev/tcp).
-a always,exit -F arch=b64 -S connect -F exe=/usr/bin/bash -F success=1 -k shell_connect
-a always,exit -F arch=b64 -S connect -F exe=/usr/bin/dash -F success=1 -k shell_connect

## ---------------------------------------------------------------------------
## Lock the rules until reboot. Left off while the lab is still being tuned;
## turn it on once the rule set is stable.
## ---------------------------------------------------------------------------
# -e 2
