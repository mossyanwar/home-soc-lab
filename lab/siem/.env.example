# Copy to .env and fill in. Never commit the real .env.

# Pin to an exact release; check https://www.elastic.co/downloads/past-releases
# for the current 8.x patch before building.
STACK_VERSION=8.15.3
CLUSTER_NAME=soclab

# Address of SIEM01 on the lab network. Ports are only published here.
LAB_BIND_IP=10.10.50.10

# At least 6 characters, letters and digits only (they are used inside shell
# and JSON strings in the setup container).
ELASTIC_PASSWORD=
KIBANA_PASSWORD=

# 32+ random characters, e.g. from: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=

# Memory. 2g heap with a 4g container limit is comfortable for a lab.
ES_HEAP=2g
ES_MEM_LIMIT=4294967296
KB_MEM_LIMIT=1073741824
